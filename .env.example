# Copy to .env for local startup or Docker Compose. Never commit .env.
# Generate distinct values: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
AEGIS_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
AEGIS_ENV=development
AEGIS_DEMO_ENABLED=true
AEGIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AEGIS_AI_PROVIDER=auto
AEGIS_AI_MODE=auto
AEGIS_KYC_VISION=auto
# Optional: add either key and restart. Explicitly choose claude/openai when both exist.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AEGIS_OPENAI_API_KEY=
# AEGIS_OPENAI_MODEL=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# Optional Firestore notification projection (Cloud Run ADC; no key file needed).
# GOOGLE_CLOUD_PROJECT=agies-bank
# FIRESTORE_DATABASE=(default)
# FIRESTORE_AGENT_NOTIFICATIONS=false
# OPENAI_API_KEY is accepted locally; use AEGIS_OPENAI_API_KEY in cloud settings.
