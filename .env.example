# Local launcher uses explicit ephemeral memory by default; no credentials required.
AEGIS_ENV=development
AEGIS_STORAGE_BACKEND=memory
AEGIS_DEMO_ENABLED=true
AGIES_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
AEGIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AEGIS_AI_PROVIDER=auto
AEGIS_KYC_VISION=auto
# Set these for a persistent local Firestore emulator or live development project.
# AEGIS_STORAGE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=demo-aegis-bank
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIRESTORE_DATABASE=(default)
# Live local development uses Application Default Credentials, outside the repo:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
# Optional provider configuration; leave values out of version control.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# ANTHROPIC_API_KEY=
# AEGIS_OPENAI_API_KEY=
# GEMINI_API_KEY=
# AEGIS_WORKER_ENABLED=true
